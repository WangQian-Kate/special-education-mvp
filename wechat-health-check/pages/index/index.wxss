.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx 64rpx;
}

.heading {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 28rpx;
}

.status-panel,
.detail-section {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 2rpx solid #e4e7ec;
  border-radius: 16rpx;
  background: #ffffff;
}

.status-row {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #98a2b3;
}

.status-title {
  font-size: 34rpx;
  font-weight: 650;
}

.status-message {
  display: block;
  margin-top: 18rpx;
  color: #667085;
  font-size: 28rpx;
  line-height: 1.6;
}

.status-loading .status-dot {
  background: #2e90fa;
}

.status-success {
  border-color: #a6f4c5;
  background: #ecfdf3;
}

.status-success .status-dot {
  background: #12b76a;
}

.status-error {
  border-color: #fecdca;
  background: #fef3f2;
}

.status-error .status-dot {
  background: #f04438;
}

.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
}

.code-text,
.response-text {
  display: block;
  overflow-wrap: anywhere;
  color: #182230;
  font-family: Consolas, "Courier New", monospace;
  font-size: 25rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.url-input {
  box-sizing: border-box;
  width: 100%;
  height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 10rpx;
  color: #182230;
  font-family: Consolas, "Courier New", monospace;
  font-size: 25rpx;
}

.url-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  height: 76rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 76rpx;
}

.primary-button {
  background: #1570ef;
  color: #ffffff;
}

.secondary-button {
  border: 2rpx solid #d0d5dd;
  background: #ffffff;
  color: #344054;
}

.test-button {
  width: 100%;
  height: 96rpx;
  margin-top: 36rpx;
  border-radius: 12rpx;
  background: #1570ef;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 96rpx;
}

.test-button[disabled] {
  background: #84adf4;
  color: #ffffff;
}
