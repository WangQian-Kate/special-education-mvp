<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.specialed.assistant.auth.TeacherIdentityMapper">
    <select id="findUserIdByTeacherId" resultType="long">
        SELECT id
        FROM app_user
        WHERE teacher_id = #{teacherId}
    </select>
</mapper>
