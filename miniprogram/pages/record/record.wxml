<!-- pages/record/record.wxml -->
<!-- ABC 行为记录页面 -->
<view class="container">
  <text class="page-title">ABC 行为记录</text>

  <view class="form-section">
    <!-- 前因 A -->
    <view class="form-group">
      <text class="form-label">
        <text class="label-tag tag-a">A</text> 前因（Antecedent）
      </text>
      <textarea class="form-textarea"
                placeholder="描述行为发生前的事件、环境或触发因素..."
                value="{{formData.antecedent}}"
                data-field="antecedent"
                bindinput="handleInputChange" />
    </view>

    <!-- 行为 B -->
    <view class="form-group">
      <text class="form-label">
        <text class="label-tag tag-b">B</text> 行为（Behavior）
      </text>
      <textarea class="form-textarea required"
                placeholder="描述目标行为的具体表现..."
                value="{{formData.behavior}}"
                data-field="behavior"
                bindinput="handleInputChange" />
    </view>

    <!-- 后果 C -->
    <view class="form-group">
      <text class="form-label">
        <text class="label-tag tag-c">C</text> 后果（Consequence）
      </text>
      <textarea class="form-textarea"
                placeholder="描述行为发生后的结果、干预措施..."
                value="{{formData.consequence}}"
                data-field="consequence"
                bindinput="handleInputChange" />
    </view>

    <!-- 地点 -->
    <view class="form-group">
      <text class="form-label">📍 发生地点</text>
      <input class="form-input"
             placeholder="如：教室、操场、食堂..."
             value="{{formData.location}}"
             data-field="location"
             bindinput="handleInputChange" />
    </view>

    <!-- 行为强度 -->
    <view class="form-group">
      <text class="form-label">📊 行为强度</text>
      <view class="intensity-selector">
        <view class="intensity-item {{formData.intensity === item.value ? 'active' : ''}}"
              wx:for="{{intensityLevels}}"
              wx:key="value"
              data-value="{{item.value}}"
              bindtap="handleIntensitySelect">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn-reset" bindtap="handleReset">重置</button>
    <button class="btn-submit" bindtap="handleSubmit">提交记录</button>
  </view>
</view>
