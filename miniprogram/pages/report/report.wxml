<!-- pages/report/report.wxml -->
<view class="container">
  <text class="page-title">分析报告</text>

  <!-- 生成报告按钮 -->
  <view class="generate-section">
    <button class="btn-generate"
            bindtap="handleGenerateReport"
            loading="{{generating}}"
            disabled="{{generating}}">
      🤖 AI 生成分析报告
    </button>
    <text class="generate-hint">基于行为记录数据，自动生成干预建议</text>
  </view>

  <!-- 历史报告列表 -->
  <view class="report-list">
    <text class="section-title">历史报告</text>

    <view class="report-card" wx:for="{{reports}}" wx:key="id">
      <view class="report-info">
        <text class="report-date">{{item.date}}</text>
        <text class="report-summary">{{item.summary}}</text>
      </view>
      <text class="report-arrow">→</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{reports.length === 0}}">
      <text class="empty-text">暂无分析报告</text>
      <text class="empty-hint">记录足够的行为数据后，可生成 AI 分析报告</text>
    </view>
  </view>
</view>
