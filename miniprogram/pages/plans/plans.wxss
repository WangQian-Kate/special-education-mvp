.search-box {
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

/* 横滑 chips（状态 / 分类共用） */
.chip-row {
  display: flex;
  align-items: center;
  white-space: nowrap;
  overflow-x: auto;
  margin-bottom: 12rpx;
  padding: 8rpx 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
  color: var(--color-text-sub);
  line-height: 1;
}

.chip.active {
  background: var(--color-primary);
  color: #ffffff;
}

/* ===== 表格 ===== */
.table {
  padding: 0;
  overflow: hidden;
}

.table-caption {
  padding: 16rpx 24rpx;
  background: var(--color-primary-light);
}

.caption-name {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.caption-count {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-left: 16rpx;
}

.tr {
  display: flex;
  align-items: center;
}

.tr.odd {
  background: #fafafa;
}

.tr.th {
  background: var(--color-primary);
}

.th .td {
  color: #ffffff;
  font-weight: 700;
}

.td {
  padding: 20rpx 8rpx;
  font-size: 20rpx;
  color: var(--color-text);
}

.col-id {
  width: 56rpx;
  text-align: center;
  color: var(--color-text-sub);
  flex-shrink: 0;
}

.col-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-c {
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
}

.col-status {
  width: 104rpx;
  text-align: center;
  flex-shrink: 0;
}

.dim {
  color: var(--color-text-sub);
}

.editable {
  color: var(--color-primary);
  font-weight: 700;
}

.editable-plain {
  color: #6b7280;
}

/* 状态标签（类名带中文值，与数据 status 字段一致） */
.status-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
}

.s-ongoing {
  background: #dbeafe;
  color: #2563eb;
}

.s-done {
  background: #dcfce7;
  color: #16a34a;
}

.s-pending {
  background: #f3f4f6;
  color: #6b7280;
}

/* ===== 训练目标关联记录弹窗 ===== */
.goal-records-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.goal-records-panel {
  width: 100%;
  max-height: 75vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.gr-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  flex-shrink: 0;
}

.gr-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.gr-close {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 0 8rpx;
  line-height: 1;
}

.gr-subtitle {
  padding: 12rpx 32rpx;
  font-size: 22rpx;
  color: var(--color-text-sub);
  flex-shrink: 0;
}

.gr-loading {
  padding: 60rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.gr-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 24rpx 32rpx;
}

.gr-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #c0c0c0;
}

.gr-item {
  background: #f9fafb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}

.gr-item-row {
  display: flex;
  align-items: center;
}

.gr-item-meta {
  margin-bottom: 8rpx;
}

.gr-date,
.gr-time,
.gr-course,
.gr-env {
  font-size: 22rpx;
  color: var(--color-text-sub);
  margin-right: 24rpx;
}

.gr-perf-row {
  margin: 10rpx 0;
}

.gr-perf-label {
  font-size: 22rpx;
  color: var(--color-text-sub);
  flex-shrink: 0;
}

.gr-perf-value {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 600;
  flex: 1;
}

.gr-status-row {
  justify-content: space-between;
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #e5e7eb;
}

.gr-behavior-label {
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.gr-status {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
}

/* 三种状态颜色：蓝 / 黄 / 绿 */
.gr-status.s-incomplete {
  background: #dbeafe;
  color: #5B9BD5;
}

.gr-status.s-assisted {
  background: #fef3c7;
  color: #F4A100;
}

.gr-status.s-independent {
  background: #dcfce7;
  color: #5CB85C;
}
