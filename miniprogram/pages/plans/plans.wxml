<wxs module="fmt">
// 中文状态 → 英文样式类（WXSS 不支持中文类名）
var map = { '未开始': 'pending', '进行中': 'ongoing', '已完成': 'done' };
module.exports = { statusClass: function (s) { return map[s] || 'pending'; } };
</wxs>
<view class="container">
  <!-- 搜索 -->
  <view class="card-sm search-box flex-row">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索训练目标或编号..." value="{{keyword}}" bindinput="onSearchInput" />
  </view>

  <!-- 状态筛选 -->
  <view class="chip-row">
    <view class="chip {{activeStatus === '' ? 'active' : ''}}" data-status="" bindtap="onStatusTap">全部</view>
    <view
      class="chip {{activeStatus === item ? 'active' : ''}}"
      wx:for="{{statusList}}"
      wx:key="*this"
      data-status="{{item}}"
      bindtap="onStatusTap"
    >{{item}}</view>
  </view>

  <!-- 分类 tabs -->
  <view class="chip-row">
    <view
      class="chip cat-chip {{activeCategory === index ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="*this"
      data-index="{{index}}"
      bindtap="onCategoryTap"
    >{{item}}</view>
  </view>

  <!-- 目标表格 -->
  <view class="table card">
    <view class="table-caption">
      <text class="caption-name">{{categories[activeCategory]}}</text>
      <text class="caption-count">{{filteredItems.length}}/{{totalCount}}项</text>
    </view>
    <view class="tr th">
      <view class="td col-id">#</view>
      <view class="td col-title">训练目标</view>
      <view class="td col-c">学期初</view>
      <view class="td col-c">当前</view>
      <view class="td col-c">阶段</view>
      <view class="td col-status">状态</view>
    </view>
    <view class="tr {{index % 2 ? 'odd' : ''}}" wx:for="{{filteredItems}}" wx:key="id"
          bindtap="onGoalTap" data-standard-number="{{item.standardNumber || item.id}}" data-goal-text="{{item.title}}">
      <view class="td col-id">{{item.standardNumber || item.id}}</view>
      <view class="td col-title">{{item.title}}</view>
      <view class="td col-c dim">{{item.level1}}</view>
      <view class="td col-c">
        <picker range="{{levels}}" data-id="{{item.id}}" data-field="levelNow" bindchange="onFieldChange">
          <view class="editable" data-field="levelNow">{{item.levelNow}}</view>
        </picker>
      </view>
      <view class="td col-c">
        <picker range="{{phases}}" data-id="{{item.id}}" data-field="phase" bindchange="onFieldChange">
          <view class="editable-plain" data-field="phase">{{item.phase}}</view>
        </picker>
      </view>
      <view class="td col-status">
        <picker range="{{statusList}}" data-id="{{item.id}}" data-field="status" bindchange="onFieldChange">
          <view class="status-tag s-{{fmt.statusClass(item.status)}}" data-field="status">{{item.status}}</view>
        </picker>
      </view>
    </view>
    <view class="empty-tip" wx:if="{{!filteredItems.length}}">无匹配的训练目标</view>
  </view>

  <!-- 训练目标关联记录弹窗 -->
  <view class="goal-records-mask" wx:if="{{goalRecordsVisible}}" bindtap="onGoalRecordsClose">
    <view class="goal-records-panel" catchtap="{{null}}">
      <view class="gr-header">
        <text class="gr-title">{{goalRecordsTitle}}</text>
        <text class="gr-close" bindtap="onGoalRecordsClose">✕</text>
      </view>
      <view class="gr-subtitle" wx:if="{{!goalRecordsLoading}}">共 {{goalRecords.length}} 条关联记录</view>
      <view class="gr-loading" wx:if="{{goalRecordsLoading}}">加载中…</view>
      <scroll-view class="gr-list" scroll-y wx:if="{{!goalRecordsLoading}}">
        <view class="gr-empty" wx:if="{{goalRecords.length === 0}}">暂无关联的行为记录</view>
        <view class="gr-item" wx:for="{{goalRecords}}" wx:key="id">
          <view class="gr-item-row gr-item-meta">
            <text class="gr-date">📅 {{item.recordDate}}</text>
            <text class="gr-time">🕐 {{item.occurredTime}}</text>
          </view>
          <view class="gr-item-row gr-item-meta">
            <text class="gr-course">📖 {{item.courseLabel}}</text>
            <text class="gr-env">📍 {{item.environmentLabel}}</text>
          </view>
          <view class="gr-item-row gr-perf-row">
            <text class="gr-perf-label">行为表现：</text>
            <text class="gr-perf-value">{{item.performanceText || '未填写'}}</text>
          </view>
          <view class="gr-item-row gr-status-row">
            <text class="gr-behavior-label">{{item.subBehaviorLabel ? item.subBehaviorLabel + ' · ' : ''}}{{item.behaviorLabel}}</text>
            <text class="gr-status s-{{item.statusCode}}">{{item.statusLabel}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
