<!-- pages/students/students.wxml -->
<view class="container">
  <view class="page-header">
    <text class="page-title">学生管理</text>
    <button class="btn-add" bindtap="handleToggleAddModal">+ 添加学生</button>
  </view>

  <!-- 学生列表 -->
  <view class="student-list" wx:if="{{students.length > 0}}">
    <view class="student-card" wx:for="{{students}}" wx:key="id">
      <text class="student-name">{{item.name}}</text>
      <text class="student-grade">{{item.grade}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无学生信息</text>
    <text class="empty-hint">点击上方按钮添加第一位学生</text>
  </view>

  <!-- 添加学生弹窗 -->
  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="handleToggleAddModal">
    <view class="modal-content" catchtap>
      <text class="modal-title">添加学生</text>
      <input class="form-input"
             placeholder="学生姓名"
             value="{{newStudent.name}}"
             data-field="name"
             bindinput="handleInputChange" />
      <input class="form-input"
             placeholder="年级/班级"
             value="{{newStudent.grade}}"
             data-field="grade"
             bindinput="handleInputChange" />
      <textarea class="form-input form-textarea"
                placeholder="备注信息（可选）"
                value="{{newStudent.remark}}"
                data-field="remark"
                bindinput="handleInputChange" />
      <view class="modal-buttons">
        <button class="btn-cancel" bindtap="handleToggleAddModal">取消</button>
        <button class="btn-confirm" bindtap="handleAddStudent">确定</button>
      </view>
    </view>
  </view>
</view>
