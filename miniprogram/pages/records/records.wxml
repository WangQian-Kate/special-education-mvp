<view class="container">
  <!-- 日/周/月切换 -->
  <view class="rec-tabs">
    <view class="rec-tab {{recordView === 'day' ? 'on' : ''}}" data-view="day" bindtap="switchRecordView">日记录</view>
    <view class="rec-tab {{recordView === 'week' ? 'on' : ''}}" data-view="week" bindtap="switchRecordView">周记录</view>
    <view class="rec-tab {{recordView === 'month' ? 'on' : ''}}" data-view="month" bindtap="switchRecordView">月记录</view>
  </view>

  <!-- ========== 日视图 ========== -->
  <block wx:if="{{recordView === 'day'}}">
    <picker mode="date" value="{{date}}" end="{{todayStr}}" bindchange="onDateChange">
      <view class="card date-bar flex-center">
        <text class="date-text">{{date}}</text><text class="date-hint">点击切换</text>
      </view>
    </picker>

    <view class="select-row flex-row">
      <picker class="select-picker" range="{{courses}}" range-key="label" value="{{courseIndex}}" bindchange="onCourseChange">
        <view class="card-sm select-view">{{courses[courseIndex].label}} ▾</view>
      </picker>
      <picker class="select-picker" range="{{environments}}" range-key="label" value="{{envIndex}}" bindchange="onEnvChange" disabled="{{courses[courseIndex].code === 'ALL_DAY_SUMMARY'}}">
        <view class="card-sm select-view">{{environments[envIndex].label}} ▾</view>
      </picker>
      <picker class="select-picker" range="{{durationPresets}}" range-key="label" bindchange="onDurationChange" disabled="{{courses[courseIndex].code === 'ALL_DAY_SUMMARY'}}">
        <view class="card-sm select-view">{{durationMinutes}}min ▾</view>
      </picker>
    </view>

    <!-- 全天汇总 -->
    <block wx:if="{{courses[courseIndex].code === 'ALL_DAY_SUMMARY'}}">
      <view class="card"><view class="note-head flex-row">
        <text class="note-title">今日教师评价</text>
        <text wx:if="{{evalSaveState === 'saving'}}" class="note-state">保存中…</text>
        <text wx:elif="{{evalSaveState === 'saved'}}" class="note-state saved">已保存</text>
        <text wx:elif="{{evalSaveState === 'error'}}" class="note-state error">保存失败</text>
      </view>
        <view class="eval-area">
          <view wx:for="{{evalFields}}" wx:for-item="f" wx:key="key" class="eval-item">
            <view class="eval-label">{{f.label}}</view>
            <textarea class="eval-input" value="{{evaluation[f.key]}}" data-field="{{f.key}}" bindinput="onEvalInput" placeholder="记录表现..." maxlength="200" />
          </view>
        </view>
      </view>

      <status-bar />
      <view wx:if="{{modules.length}}">
        <behavior-module
          wx:for="{{modules}}"
          wx:key="code"
          module="{{item}}"
          expanded="{{!item.expanded}}"
          readonly="{{true}}"
          bind:toggle="onModuleToggle"
          bind:statuschange="onStatusChange"
          bind:nametap="onBehaviorNameTap"
          bind:subnametap="onSubNameTap"
        />
      </view>
      <view wx:elif="{{!loading}}" class="card empty-tip">今日暂无行为记录</view>
    </block>

    <!-- 普通课程：行为模块 -->
    <block wx:else>
      <view class="card note-card">
        <view class="note-head flex-row">
          <text class="note-title">课堂备注</text>
          <text wx:if="{{noteSaveState === 'saving'}}" class="note-state">保存中…</text>
          <text wx:elif="{{noteSaveState === 'saved'}}" class="note-state saved">已保存</text>
          <text wx:elif="{{noteSaveState === 'error'}}" class="note-state error" bindtap="onNoteRetryTap">保存失败 · 点此重试</text>
        </view>
        <textarea class="note-input" placeholder="记录本节课整体情况..." value="{{note}}" bindinput="onNoteInput" maxlength="500" />
      </view>

      <!-- 行为模块列表（全局状态栏只在最上方） -->
      <status-bar />
      <view wx:if="{{modules.length}}">
        <behavior-module
          wx:for="{{modules}}"
          wx:key="code"
          module="{{item}}"
          expanded="{{!item.expanded}}"
          bind:toggle="onModuleToggle"
          bind:statuschange="onStatusChange"
          bind:nametap="onBehaviorNameTap"
          bind:subnametap="onSubNameTap"
        />
      </view>
      <view wx:elif="{{!loading}}" class="card empty-tip">该课程暂无行为目录配置</view>
    </block>

    <abc-modal visible="{{abcVisible}}" class-record-id="{{classRecordId}}" record-date="{{date}}" behavior="{{abcBehavior}}" perf-options="{{abcPerfOptions}}" sub-behavior-code="{{abcSubBehaviorCode}}" all-day="{{courses[courseIndex].code === 'ALL_DAY_SUMMARY'}}" bind:close="onAbcClose" bind:changed="onAbcChanged" />
  </block>

  <!-- ========== 周视图 ========== -->
  <block wx:elif="{{recordView === 'week'}}">
    <!-- 周期选择器 -->
    <view class="card wk-nav flex-center">
      <text class="wk-nav-btn" bindtap="wkPrev">◀</text>
      <text class="wk-nav-label">第{{wkWeekNum}}周 ({{wkWeekRange}})</text>
      <text class="wk-nav-btn" bindtap="wkNext">▶</text>
    </view>
    <view wx:if="{{wkLoading}}" class="card empty-tip">加载中…</view>
    <block wx:elif="{{wkEmpty}}"><view class="card empty-tip">本周暂无记录</view></block>
    <block wx:else>
      <!-- 1. 本周记录概览 -->
      <view class="card section"><view class="sec-title">本周记录概览</view>
        <view class="ov-grid">
          <view class="ov-i"><text class="ov-v">{{wkOverview.behaviorRecordCount || wkTotal}}</text><text class="ov-l">记录总次数</text></view>
          <view class="ov-i"><text class="ov-v">{{wkOverview.observationCourseCount || 0}}</text><text class="ov-l">涉及课程</text></view>
          <view class="ov-i"><text class="ov-v">{{wkItems.length}}</text><text class="ov-l">涉及行为</text></view>
          <view class="ov-i"><text class="ov-v">{{wkGoalCount}}</text><text class="ov-l">涉及训练目标</text></view>
        </view>
      </view>
      <!-- 2. 行为状态统计 -->
      <view class="card section"><view class="block-title">行为状态统计</view>
        <view class="donut-stats">
          <view class="donut-bar c-ind" style="width:{{wkPctIncomplete}}%"></view>
          <view class="donut-bar c-ass" style="width:{{wkPctAssisted}}%"></view>
          <view class="donut-bar c-inde" style="width:{{wkPctIndependent}}%"></view>
        </view>
        <view class="donut-legs">
          <text class="dl"><text class="dl-dot c-ind"></text>未完成 {{wkDist.incomplete}}次 ({{wkPctIncomplete}}%)</text>
          <text class="dl"><text class="dl-dot c-ass"></text>辅助 {{wkDist.assisted}}次 ({{wkPctAssisted}}%)</text>
          <text class="dl"><text class="dl-dot c-inde"></text>独立 {{wkDist.independent}}次 ({{wkPctIndependent}}%)</text>
        </view>
      </view>
      <!-- 3. 每日记录趋势（折线图） -->
      <view class="card section"><view class="block-title">每日记录趋势</view>
        <view class="chart-box" wx:if="{{wkDailyTrend.length}}">
          <ec-canvas id="wk-line-chart" canvas-id="wk-line-chart" ec="{{ecWkLine}}"></ec-canvas>
        </view>
        <view wx:if="{{!wkDailyTrend.length}}" class="empty-tip">暂无数据</view>
      </view>
      <!-- 4. 训练目标变化 -->
      <view class="card section"><view class="block-title">训练目标变化</view>
        <view wx:for="{{wkGoalChanges}}" wx:key="id" class="tr-row">
          <view class="tr-info">
            <text class="tr-name">{{item.standardNumber}} {{item.goalText}}</text>
            <text class="tr-date">{{item.changedAt}}</text>
          </view>
          <text class="tr-change">{{item.fieldLabel}}：{{item.oldValue}} → {{item.newValue}}</text>
        </view>
        <view wx:if="{{!wkGoalChanges.length}}" class="empty-tip">暂无变更记录</view>
      </view>
      <!-- 5. 课程维度统计 -->
      <view class="card section" wx:if="{{wkCourses.length}}"><view class="block-title">课程维度统计</view>
        <view class="tbl"><view class="tbl-h"><text class="tbl-c1">课程</text><text class="tbl-c2">总数</text><text class="tbl-c2">独立</text><text class="tbl-c2">辅助</text><text class="tbl-c2">未完成</text><text class="tbl-c3">独立率</text></view>
          <view wx:for="{{wkCourses}}" wx:key="name" class="tbl-r"><text class="tbl-c1">{{item.name}}</text><text class="tbl-c2">{{item.count}}</text><text class="tbl-c2">{{item.ind}}</text><text class="tbl-c2">{{item.ass}}</text><text class="tbl-c2">{{item.inc}}</text><text class="tbl-c3">{{item.rate}}%</text></view>
        </view>
      </view>
      <!-- 6. 环境维度统计 -->
      <view class="card section" wx:if="{{wkEnvs.length}}"><view class="block-title">环境维度统计</view>
        <view class="tbl"><view class="tbl-h"><text class="tbl-c1">环境</text><text class="tbl-c2">总数</text><text class="tbl-c2">独立</text><text class="tbl-c2">辅助</text><text class="tbl-c2">未完成</text><text class="tbl-c3">独立率</text></view>
          <view wx:for="{{wkEnvs}}" wx:key="name" class="tbl-r"><text class="tbl-c1">{{item.name}}</text><text class="tbl-c2">{{item.count}}</text><text class="tbl-c2">{{item.ind}}</text><text class="tbl-c2">{{item.ass}}</text><text class="tbl-c2">{{item.inc}}</text><text class="tbl-c3">{{item.rate}}%</text></view>
        </view>
      </view>
      <!-- 7. 高频行为统计（三色堆叠条） -->
      <view class="card section" wx:if="{{wkTop6.length}}"><view class="block-title">高频行为统计</view>
        <view wx:for="{{wkTop6}}" wx:key="behaviorCode" class="triple-row">
          <text class="tr-name">{{item.behaviorLabel}}</text>
          <view class="tr-bar-bg" style="width:{{(item.count / wkMaxTop) * 100 || 0}}%">
            <view class="triple-s ind" style="width:{{item._indPct || 0}}%"></view>
            <view class="triple-s ass" style="width:{{item._assPct || 0}}%"></view>
            <view class="triple-s ine" style="width:{{item._inePct || 0}}%"></view>
          </view>
          <text class="tr-count">{{item.count}}次</text>
        </view>
        <view class="triple-legend">
          <text class="dl"><text class="dl-dot c-inde"></text>独立</text>
          <text class="dl"><text class="dl-dot c-ass"></text>辅助</text>
          <text class="dl"><text class="dl-dot c-ind"></text>未完成</text>
        </view>
      </view>
      <!-- 8. ABC统计 -->
      <view class="card section"><view class="block-title">ABC 行为功能统计</view>
        <view wx:for="{{wkAbcDist}}" wx:key="label" class="tr-row">
          <text class="tr-name">{{item.label}}</text>
          <view class="tr-bar-bg"><view class="tr-bar" style="width:{{item.pct}}%"></view></view>
          <text class="tr-count">{{item.pct}}%</text>
        </view>
        <view wx:if="{{!wkAbcDist.length}}" class="empty-tip">暂无ABC数据</view>
      </view>
    </block>
  </block>

  <!-- ========== 月视图 ========== -->
  <block wx:elif="{{recordView === 'month'}}">
    <view class="card wk-nav flex-center">
      <text class="wk-nav-btn" bindtap="wkPrev">◀</text>
      <text class="wk-nav-label">{{wkMonthLabel}}</text>
      <text class="wk-nav-btn" bindtap="wkNext">▶</text>
    </view>
    <view wx:if="{{wkLoading}}" class="card empty-tip">加载中…</view>
    <block wx:elif="{{wkEmpty}}"><view class="card empty-tip">本月暂无记录</view></block>
    <block wx:else>
      <!-- 1. 月度概览 -->
      <view class="card section"><view class="sec-title">月度概览</view>
        <view class="ov-grid">
          <view class="ov-i"><text class="ov-v">{{wkOverview.behaviorRecordCount || wkTotal}}</text><text class="ov-l">记录总次数</text></view>
          <view class="ov-i"><text class="ov-v">{{wkGoalCount}}</text><text class="ov-l">训练目标覆盖</text></view>
          <view class="ov-i"><text class="ov-v">{{wkOverview.observationCourseCount || 0}}</text><text class="ov-l">涉及课程</text></view>
        </view>
      </view>
      <!-- 2. 每周记录趋势（三线） -->
      <view class="card section" wx:if="{{wkWeeklyBreakdown.length}}"><view class="block-title">每周记录趋势</view>
        <view class="chart-box">
          <ec-canvas id="mo-trend-chart" canvas-id="mo-trend-chart" ec="{{ecMoTrend}}"></ec-canvas>
        </view>
      </view>
      <!-- 3. 月度状态变化（独立率折线） -->
      <view class="card section" wx:if="{{wkWeeklyBreakdown.length}}"><view class="block-title">月度状态变化</view>
        <view class="chart-box">
          <ec-canvas id="mo-line-chart" canvas-id="mo-line-chart" ec="{{ecMoLine}}"></ec-canvas>
        </view>
      </view>
      <!-- 表格辅助：per-week 明细 -->
      <view class="card section" wx:if="{{wkWeeklyBreakdown.length}}">
        <view class="tbl">
          <view class="tbl-h"><text class="tbl-c1">周次</text><text class="tbl-c2">总数</text><text class="tbl-c2">独立</text><text class="tbl-c2">辅助</text><text class="tbl-c2">未完成</text><text class="tbl-c3">独立率</text></view>
          <view wx:for="{{wkWeeklyBreakdown}}" wx:key="week" class="tbl-r">
            <text class="tbl-c1">第{{item.week}}周</text>
            <text class="tbl-c2">{{item.totalCount}}</text>
            <text class="tbl-c2">{{item.independentCount}}</text>
            <text class="tbl-c2">{{item.assistedCount}}</text>
            <text class="tbl-c2">{{item.incompleteCount}}</text>
            <text class="tbl-c3">{{item.independentRate}}%</text>
          </view>
        </view>
        <view wx:if="{{!wkWeeklyBreakdown.length}}" class="empty-tip">暂无数据</view>
      </view>
      <!-- 3. 训练目标变化 -->
      <view class="card section"><view class="block-title">训练目标变化</view>
        <view wx:for="{{wkGoalChanges}}" wx:key="id" class="tr-row">
          <view class="tr-info">
            <text class="tr-name">{{item.standardNumber}} {{item.goalText}}</text>
            <text class="tr-date">{{item.changedAt}}</text>
          </view>
          <text class="tr-change">{{item.fieldLabel}}：{{item.oldValue}} → {{item.newValue}}</text>
        </view>
        <view wx:if="{{!wkGoalChanges.length}}" class="empty-tip">本月无变更记录</view>
      </view>
      <!-- ABC 行为功能统计 -->
      <view class="card section"><view class="block-title">ABC 行为功能统计</view>
        <view wx:for="{{wkAbcDist}}" wx:key="label" class="tr-row">
          <text class="tr-name">{{item.label}}</text>
          <view class="tr-bar-bg"><view class="tr-bar" style="width:{{item.pct}}%"></view></view>
          <text class="tr-count">{{item.pct}}%</text>
        </view>
        <view wx:if="{{!wkAbcDist.length}}" class="empty-tip">暂无ABC数据</view>
      </view>
    </block>
  </block>
</view>
