.date-bar {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.date-hint {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-left: 16rpx;
}

.select-row {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.select-picker {
  flex: 1;
}

.select-view {
  text-align: center;
  font-size: 26rpx;
  color: #4b5563;
}

.note-card {
  margin-bottom: 24rpx;
}

.note-input {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
}

.behavior-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
