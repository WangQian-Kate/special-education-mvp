.date-bar {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.date-hint {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-left: 16rpx;
}

.select-row {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.select-picker {
  flex: 1;
}

.select-view {
  text-align: center;
  font-size: 26rpx;
  color: #4b5563;
}

.note-card {
  margin-bottom: 24rpx;
}

.note-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.note-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-sub);
}

.note-state {
  font-size: 20rpx;
  color: var(--color-text-sub);
}

.note-state.saved {
  color: var(--color-success);
}

.note-state.error {
  color: var(--color-danger);
}

.note-input {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
}

.behavior-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ===== 视图切换 tabs ===== */
.view-tabs { display: flex; padding: 4rpx; margin-bottom: 16rpx; }

.view-tab {
  flex: 1; text-align: center; padding: 10rpx 0;
  font-size: 24rpx; font-weight: 600; color: #9ca3af; border-radius: 20rpx;
}

.view-tab.on { background: var(--color-primary); color: #fff; font-weight: 700; }

/* ===== 全天汇总评价 ===== */
.eval-area { display: flex; flex-direction: column; gap: 16rpx; }

.eval-item { background: #f9fafb; border-radius: 14rpx; padding: 16rpx; }

.eval-label { font-size: 24rpx; font-weight: 700; color: var(--color-text-sub); margin-bottom: 8rpx; }

.eval-input { width: 100%; height: 80rpx; font-size: 24rpx; background: transparent; }

/* ===== 统计行 ===== */
.stat-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-bottom: 1rpx solid #f3f4f6;
}

.stat-name { font-size: 26rpx; color: var(--color-text); }

.stat-count { font-size: 26rpx; font-weight: 900; color: var(--color-primary); }
