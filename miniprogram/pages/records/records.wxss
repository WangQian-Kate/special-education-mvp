.date-bar {
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.date-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.date-hint {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-left: 16rpx;
}

.select-row {
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.select-picker {
  flex: 1;
}

.select-view {
  text-align: center;
  font-size: 26rpx;
  color: #4b5563;
}

.note-card {
  margin-bottom: 24rpx;
}

.note-head {
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.note-title {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-sub);
}

.note-state {
  font-size: 20rpx;
  color: var(--color-text-sub);
}

.note-state.saved {
  color: var(--color-success);
}

.note-state.error {
  color: var(--color-danger);
}

.note-input {
  width: 100%;
  height: 140rpx;
  font-size: 26rpx;
}

.behavior-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* ===== 视图切换 tabs ===== */
.rec-tabs {
  display: flex; padding: 4rpx; margin-bottom: 16rpx;
  background: #fff; border-radius: 24rpx;
}

.rec-tab {
  flex: 1; text-align: center; padding: 10rpx 0;
  font-size: 24rpx; font-weight: 600; color: #9ca3af; border-radius: 20rpx;
}

.rec-tab.on { background: var(--color-primary); color: #fff; font-weight: 700; }

/* ===== 全天汇总评价 ===== */
.eval-area { display: flex; flex-direction: column; gap: 16rpx; }

.eval-item { background: #f9fafb; border-radius: 14rpx; padding: 16rpx; }

.eval-label { font-size: 24rpx; font-weight: 700; color: var(--color-text-sub); margin-bottom: 8rpx; }

.eval-input { width: 100%; height: 80rpx; font-size: 24rpx; background: transparent; }

/* ===== 统计行 ===== */
.stat-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-bottom: 1rpx solid #f3f4f6;
}

.stat-name { font-size: 26rpx; color: var(--color-text); }

.stat-count { font-size: 26rpx; font-weight: 900; color: var(--color-primary); }

.stat-tappable { cursor: pointer; }

.stat-tappable:active { background: #f3f4f6; }

/* 周/月视图 */
.ov-grid { display: flex; text-align: center; }
.ov-i { flex: 1; }
.ov-v { display: block; font-size: 36rpx; font-weight: 800; color: var(--color-primary); }
.ov-l { font-size: 20rpx; color: var(--color-text-sub); margin-top: 4rpx; }

.donut-stats { display: flex; gap: 4rpx; margin-bottom: 12rpx; }
.donut-bar { height: 20rpx; border-radius: 10rpx; }
.c-ind { background: #5B9BD5; }
.c-ass { background: #f59e0b; }
.c-inde { background: #22c55e; }

.donut-legs { display: flex; flex-wrap: wrap; gap: 16rpx; }
.dl { font-size: 22rpx; color: var(--color-text); display: inline-flex; align-items: center; gap: 6rpx; }
.dl-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; display: inline-block; }

.tr-row { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 0; }
.tr-name { width: 128rpx; font-size: 24rpx; color: var(--color-text); flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tr-bar-bg { flex: 1; height: 22rpx; background: #f3f4f6; border-radius: 11rpx; overflow: hidden; display: flex; }
.tr-bar { height: 100%; border-radius: 11rpx; min-width: 6rpx; }
.tr-count { font-size: 22rpx; font-weight: 700; color: var(--color-text); width: 56rpx; text-align: right; flex-shrink: 0; }

.section { margin-bottom: 20rpx; }

.chart-box { width: 100%; height: 300rpx; }
ec-canvas { width: 100%; height: 100%; display: block; }

.wk-nav { padding: 20rpx; margin-bottom: 16rpx; }
.wk-nav-btn { font-size: 28rpx; color: var(--color-primary); padding: 0 16rpx; }
.wk-nav-label { font-size: 28rpx; font-weight: 700; color: var(--color-text); }

.tr-chg { font-size: 20rpx; font-weight: 700; width: 40rpx; text-align: right; flex-shrink: 0; }
.tr-chg.up { color: #ef4444; }
.tr-chg.down { color: #22c55e; }

.triple-row { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 0; }
.triple-bar { flex: 1; height: 24rpx; border-radius: 12rpx; overflow: hidden; display: flex; }
.triple-s { height: 100%; }
.triple-s.ind { background: #22c55e; }
.triple-s.ass { background: #f59e0b; }
.triple-s.ine { background: #5B9BD5; }
.triple-legend { display: flex; gap: 20rpx; margin-top: 10rpx; }

.tbl { width: 100%; }
.tbl-h { display: flex; font-size: 22rpx; font-weight: 700; color: var(--color-text-sub); padding: 8rpx 0; border-bottom: 2rpx solid #e5e7eb; }
.tbl-r { display: flex; font-size: 24rpx; color: var(--color-text); padding: 12rpx 0; border-bottom: 1rpx solid #f3f4f6; }
.tbl-c1 { flex: 1; }
.tbl-c2 { width: 80rpx; text-align: center; flex-shrink: 0; }
.tbl-c3 { width: 80rpx; text-align: center; flex-shrink: 0; }

.goal-mod { margin-bottom: 16rpx; }
.goal-mod-name { font-size: 24rpx; font-weight: 700; color: var(--color-primary); display: block; margin-bottom: 8rpx; }
.goal-row { display: flex; align-items: center; padding: 6rpx 0; }
.goal-text { flex: 1; font-size: 22rpx; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goal-stat { font-size: 20rpx; margin-left: 12rpx; flex-shrink: 0; }
.goal-stat.ind { color: #22c55e; }
.goal-stat.ass { color: #f59e0b; }
