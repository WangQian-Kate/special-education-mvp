<view class="container">
  <view class="card view-tabs">
    <view class="view-tab {{view === 'daily' ? 'on' : ''}}" data-view="daily" bindtap="onSwitchView">日报</view>
    <view class="view-tab {{view === 'weekly' ? 'on' : ''}}" data-view="weekly" bindtap="onSwitchView">周报</view>
    <view class="view-tab {{view === 'monthly' ? 'on' : ''}}" data-view="monthly" bindtap="onSwitchView">月报</view>
    <view class="view-tab {{view === 'semester' ? 'on' : ''}}" data-view="semester" bindtap="onSwitchView">学期</view>
  </view>

  <view wx:if="{{loading}}" class="card empty-tip">加载中…</view>
  <view wx:elif="{{empty && view !== 'semester'}}" class="card empty-tip">暂无数据</view>

  <!-- ==================== 日报 ==================== -->
  <block wx:elif="{{view === 'daily' && !empty}}">
    <view class="card section"><view class="sec-title">今日概况</view>
      <view class="ov-grid"><view class="ov-i"><text class="ov-v">{{overview.behaviorRecordCount || totalCount}}</text><text class="ov-l">行为记录</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.abcRecordCount || 0}}</text><text class="ov-l">ABC详录</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.observationCourseCount || 0}}</text><text class="ov-l">观察课程</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.remarkCount || 0}}</text><text class="ov-l">备注</text></view></view>
    </view>

    <view class="card section" wx:if="{{dailyBars.length}}">
      <view class="sec-title">今日行为分布</view>
      <view wx:for="{{dailyBars}}" wx:key="label" class="dist-row">
        <view class="dist-head">
          <text class="dist-label">{{item.label}}</text>
          <text class="dist-count">{{item.count}}次</text>
        </view>
        <view class="dist-bar-wrap">
          <view class="dist-bar dist-ind" style="width:{{item.indPct || 0}}%">{{item.ind > 0 ? '独立' + item.ind : ''}}</view>
          <view class="dist-bar dist-ass" style="width:{{item.assPct || 0}}%">{{item.ass > 0 ? '辅助' + item.ass : ''}}</view>
          <view class="dist-bar dist-inc" style="width:{{item.incPct || 0}}%">{{item.inc > 0 ? '未完成' + item.inc : ''}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- ==================== 周报 / 月报（仅概览 + AI 分析，详细图表见随班记录页） ==================== -->
  <block wx:elif="{{(view === 'weekly' || view === 'monthly') && !empty}}">
    <view class="card section"><view class="sec-title">{{view === 'weekly' ? '本周' : '本月'}}记录概览</view>
      <view class="ov-grid"><view class="ov-i"><text class="ov-v">{{overview.behaviorRecordCount || totalCount}}</text><text class="ov-l">记录总次数</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.observationCourseCount || 0}}</text><text class="ov-l">涉及课程</text></view>
      <view class="ov-i"><text class="ov-v">{{items.length}}</text><text class="ov-l">涉及行为</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.trainingGoalCount || 0}}</text><text class="ov-l">训练目标</text></view></view>
    </view>

    <!-- AI 三维度分析报告 -->
    <view class="card section" wx:if="{{aiReport}}">
      <view class="block-title">🤖 AI 智能分析</view>
      <view wx:if="{{aiReport.behaviorChanges && aiReport.behaviorChanges.length}}" class="ai-group">
        <text class="ai-group-title">📊 {{view === 'weekly' ? '行为变化与趋势' : '月度发展总结'}}</text>
        <ai-card wx:for="{{aiReport.behaviorChanges}}" wx:key="title" type="info" title="{{item.title}}" content="{{item.content}}" />
      </view>
      <view wx:if="{{aiReport.attentionConcerns && aiReport.attentionConcerns.length}}" class="ai-group">
        <text class="ai-group-title">⚠️ 关注提醒</text>
        <ai-card wx:for="{{aiReport.attentionConcerns}}" wx:key="title" type="warn" title="{{item.title}}" content="{{item.content}}" />
      </view>
      <view wx:if="{{aiReport.alternativeSuggestions && aiReport.alternativeSuggestions.length}}" class="ai-group">
        <text class="ai-group-title">💡 {{view === 'weekly' ? '干预建议' : '长期目标建议'}}</text>
        <ai-card wx:for="{{aiReport.alternativeSuggestions}}" wx:key="title" type="success" title="{{item.title}}" content="{{item.content}}" />
      </view>
    </view>
    <view class="card section" wx:elif="{{aiReportLoading}}"><view class="block-title">🤖 AI 智能分析</view>
      <view class="empty-tip">AI 分析生成中，请稍候…</view>
    </view>
    <view class="card section" wx:else><view class="block-title">🤖 AI 智能分析</view>
      <view class="empty-tip">暂无AI分析数据</view>
    </view>
  </block>

  <!-- ==================== 学期 ==================== -->
  <block wx:elif="{{view === 'semester'}}">
    <view class="card section"><view class="sec-title">学期概览</view>
      <view class="ov-grid"><view class="ov-i"><text class="ov-v">{{overview.behaviorRecordCount}}</text><text class="ov-l">行为记录</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.abcRecordCount}}</text><text class="ov-l">ABC详录</text></view>
      <view class="ov-i"><text class="ov-v">{{overview.remarkCount}}</text><text class="ov-l">备注</text></view></view>
    </view>
    <view class="card section"><view class="block-title">AI 学期总结</view>
      <ai-card type="info" title="学期总评" content="六大能力维度均有提升，平均进步20%。" />
      <ai-card type="warn" title="薄弱环节" content="专注力+14%，集体课参与度58%，建议加强感统训练。" />
      <ai-card type="success" title="下学期建议" content="引入同伴支持策略提升社交互动。" /></view>
  </block>
</view>
