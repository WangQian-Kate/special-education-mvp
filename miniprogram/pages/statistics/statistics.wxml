<view class="container">
  <!-- 今日概况 -->
  <view class="card section">
    <view class="sec-title">今日概况（静态 Demo）</view>
    <stat-grid items="{{summary}}" />
  </view>

  <!-- 行为频次柱状图：ECharts 真机渲染验证 -->
  <view class="card section">
    <view class="block-title chart-title">行为频次统计</view>
    <view class="chart-box">
      <ec-canvas id="behavior-chart" canvas-id="behavior-chart" ec="{{ec}}"></ec-canvas>
    </view>
  </view>

  <!-- AI 智能分析（静态 Demo） -->
  <view class="card section">
    <view class="ai-header flex-row">
      <text class="ai-title">AI 智能分析</text>
      <text class="ai-tag">Demo 数据</text>
    </view>
    <view class="ai-list">
      <ai-card
        wx:for="{{aiCards}}"
        wx:key="title"
        type="{{item.type}}"
        title="{{item.title}}"
        content="{{item.content}}"
      />
    </view>
  </view>
</view>
