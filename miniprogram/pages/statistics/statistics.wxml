<view class="container">
  <!-- 周期切换 tabs -->
  <view class="card view-tabs">
    <view class="view-tab {{view === 'daily' ? 'on' : ''}}" data-view="daily" bindtap="onSwitchView">日报</view>
    <view class="view-tab {{view === 'weekly' ? 'on' : ''}}" data-view="weekly" bindtap="onSwitchView">周报</view>
    <view class="view-tab {{view === 'monthly' ? 'on' : ''}}" data-view="monthly" bindtap="onSwitchView">月报</view>
    <view class="view-tab {{view === 'semester' ? 'on' : ''}}" data-view="semester" bindtap="onSwitchView">学期报告</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="card empty-tip">加载中…</view>

  <!-- 空态（非加载、非学期） -->
  <view wx:elif="{{empty && view !== 'semester'}}" class="card empty-tip">当前周期暂无行为记录</view>

  <!-- ========== 日报 ========== -->
  <block wx:elif="{{view === 'daily' && !empty}}">
    <view class="card section" wx:if="{{overview}}">
      <view class="sec-title">今日概况</view>
      <view class="overview-grid">
        <view class="ov-item"><text class="ov-val">{{overview.behaviorRecordCount || totalCount}}</text><text class="ov-label">行为记录</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.abcRecordCount || 0}}</text><text class="ov-label">ABC详录</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.observationCourseCount || 0}}</text><text class="ov-label">观察课程</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.remarkCount || 0}}</text><text class="ov-label">备注</text></view>
      </view>
    </view>

    <view class="card section" wx:if="{{dailyBars.length}}">
      <view class="block-title">行为频次统计</view>
      <view class="bar-chart">
        <view wx:for="{{dailyBars}}" wx:key="label" class="bar-col">
          <view class="bar-fill {{item.positive ? 'positive' : ''}}" style="height:{{(item.count / dailyMaxCount) * 100}}%"></view>
          <text class="bar-count">{{item.count}}</text>
          <text class="bar-name">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="card section" wx:if="{{aiCards.length}}">
      <view class="ai-header"><text class="ai-title">AI 智能分析</text></view>
      <view class="ai-list"><ai-card wx:for="{{aiCards}}" wx:key="title" type="{{item.type}}" title="{{item.title}}" content="{{item.content}}" /></view>
    </view>
  </block>

  <!-- ========== 周报 / 月报（共用趋势列表） ========== -->
  <block wx:elif="{{(view === 'weekly' || view === 'monthly') && !empty}}">
    <view class="card section" wx:if="{{overview}}">
      <view class="sec-title">{{view === 'weekly' ? '本周' : '本月'}}概况</view>
      <view class="overview-grid">
        <view class="ov-item"><text class="ov-val">{{overview.behaviorRecordCount || totalCount}}</text><text class="ov-label">行为记录</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.abcRecordCount || 0}}</text><text class="ov-label">ABC详录</text></view>
      </view>
    </view>

    <view class="card section" wx:if="{{items.length}}">
      <view class="block-title">行为趋势{{view === 'weekly' ? '对比' : ''}}</view>
      <view class="trend-list">
        <view wx:for="{{items}}" wx:key="behaviorCode" class="trend-row">
          <text class="trend-name">{{item.behaviorLabel}}</text>
          <view class="trend-bar-bg"><view class="trend-bar" style="width:{{(item.count / totalCount) * 100 || 0}}%;background:{{item.trendDirection === 'UP' ? '#ef4444' : item.trendDirection === 'DOWN' ? '#22c55e' : '#9ca3af'}}"></view></view>
          <text class="trend-count">{{item.count}}次</text>
          <text class="trend-change {{item.trendDirection === 'UP' ? 'up' : item.trendDirection === 'DOWN' ? 'down' : ''}}">{{item.trendDirection === 'UP' ? '↑' : item.trendDirection === 'DOWN' ? '↓' : '→'}} {{item.changePercent != null ? (item.changePercent >= 0 ? '+' : '') + item.changePercent + '%' : '新增'}}</text>
        </view>
      </view>
    </view>

    <view class="card section" wx:if="{{aiCards.length}}">
      <view class="ai-header"><text class="ai-title">AI {{view === 'weekly' ? '周报' : '月报'}}分析</text></view>
      <view class="ai-list"><ai-card wx:for="{{aiCards}}" wx:key="title" type="{{item.type}}" title="{{item.title}}" content="{{item.content}}" /></view>
    </view>
  </block>

  <!-- ========== 学期报告（静态占位） ========== -->
  <block wx:elif="{{view === 'semester'}}">
    <view class="card section"><view class="sec-title">学期概览</view>
      <view class="overview-grid">
        <view class="ov-item"><text class="ov-val">{{overview.behaviorRecordCount}}</text><text class="ov-label">行为记录</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.abcRecordCount}}</text><text class="ov-label">ABC详录</text></view>
        <view class="ov-item"><text class="ov-val">{{overview.remarkCount}}</text><text class="ov-label">备注</text></view>
      </view>
    </view>
    <view class="card section" wx:if="{{aiCards.length}}">
      <view class="ai-header"><text class="ai-title">AI 学期总结</text></view>
      <view class="ai-list"><ai-card wx:for="{{aiCards}}" wx:key="title" type="{{item.type}}" title="{{item.title}}" content="{{item.content}}" /></view>
    </view>
  </block>
</view>
