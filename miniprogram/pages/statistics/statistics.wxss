.section {
  margin-bottom: 20rpx;
}

.chart-title {
  margin-bottom: 24rpx;
}

/* ec-canvas 必须有确定高度 */
.chart-box {
  width: 100%;
  height: 400rpx;
}

ec-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.ai-header {
  margin-bottom: 20rpx;
}

.ai-title {
  font-size: 28rpx;
  font-weight: 700;
}

.ai-tag {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-left: 12rpx;
}

.ai-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
