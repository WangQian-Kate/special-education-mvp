.section { margin-bottom: 20rpx; }

/* ===== 视图切换 tabs ===== */
.view-tabs {
  display: flex; padding: 4rpx; margin-bottom: 20rpx;
}

.view-tab {
  flex: 1; text-align: center; padding: 12rpx 0;
  font-size: 24rpx; font-weight: 600; color: #9ca3af;
  border-radius: 20rpx; transition: all 0.2s;
}

.view-tab.on {
  background: var(--color-primary); color: #fff; font-weight: 700;
}

/* ===== 图表 ===== */
.chart-title { margin-bottom: 24rpx; }

.chart-box { width: 100%; height: 360rpx; }

ec-canvas { width: 100%; height: 100%; display: block; }

/* ===== 趋势条 ===== */
.trend-list { display: flex; flex-direction: column; gap: 14rpx; }

.trend-row {
  display: flex; align-items: center; gap: 12rpx;
}

.trend-name { width: 128rpx; font-size: 24rpx; color: var(--color-text); flex-shrink: 0; }

.trend-bar-bg {
  flex: 1; height: 28rpx; background: #f3f4f6; border-radius: 14rpx; overflow: hidden;
}

.trend-bar {
  height: 100%; border-radius: 14rpx; min-width: 8rpx;
}

.trend-count {
  font-size: 24rpx; font-weight: 700; color: var(--color-text); width: 72rpx; text-align: right; flex-shrink: 0;
}

.trend-change {
  font-size: 22rpx; font-weight: 700; width: 68rpx; text-align: right; flex-shrink: 0;
}

.trend-change.up { color: #22c55e; }

.trend-change.down { color: #ef4444; }

/* ===== 维度评估 ===== */
.dim-list { display: flex; flex-direction: column; gap: 18rpx; }

.dim-row { display: flex; align-items: center; gap: 12rpx; }

.dim-name { font-size: 24rpx; font-weight: 700; color: var(--color-text); width: 168rpx; flex-shrink: 0; }

.dim-head { display: flex; justify-content: space-between; margin-bottom: 4rpx; }

.dim-label { font-size: 20rpx; color: var(--color-text-sub); }

.dim-bar-bg {
  flex: 1; height: 24rpx; background: #f3f4f6; border-radius: 12rpx; overflow: hidden;
}

.dim-double { position: relative; }

.dim-bar { height: 100%; border-radius: 12rpx; background: var(--color-primary); }

.dim-bar-initial {
  position: absolute; left: 0; top: 0; height: 100%;
  border-radius: 12rpx; background: #d1d5db; z-index: 1;
}

.dim-bar-current {
  position: absolute; left: 0; top: 0; height: 100%;
  border-radius: 12rpx; z-index: 2;
}

.dim-change {
  font-size: 22rpx; font-weight: 700; width: 68rpx; text-align: right; flex-shrink: 0;
}

.dim-change.up { color: #22c55e; }

.dim-change.down { color: #ef4444; }

/* ===== AI 卡片 ===== */
.ai-header { margin-bottom: 20rpx; }

.ai-title { font-size: 28rpx; font-weight: 700; }

.ai-list { display: flex; flex-direction: column; gap: 16rpx; }
