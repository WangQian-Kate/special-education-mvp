.section { margin-bottom: 20rpx; }

.view-tabs { display: flex; padding: 4rpx; margin-bottom: 20rpx; }

.view-tab { flex: 1; text-align: center; padding: 10rpx 0; font-size: 24rpx; font-weight: 600; color: #9ca3af; border-radius: 20rpx; }

.view-tab.on { background: var(--color-primary); color: #fff; font-weight: 700; }

/* Overview */
.overview-grid { display: flex; text-align: center; }

.ov-item { flex: 1; }

.ov-val { display: block; font-size: 36rpx; font-weight: 800; color: var(--color-primary); }

.ov-label { font-size: 20rpx; color: var(--color-text-sub); margin-top: 4rpx; }

/* ECharts */
.chart-box { width: 100%; height: 300rpx; }

ec-canvas { width: 100%; height: 100%; display: block; }

/* Percentage row */
.pct-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }

.pct-item { display: flex; align-items: center; gap: 6rpx; width: 48%; }

.pct-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--color-primary); flex-shrink: 0; }

.pct-dot.positive { background: var(--color-success); }

.pct-name { font-size: 22rpx; color: var(--color-text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.pct-val { font-size: 20rpx; color: var(--color-text-sub); flex-shrink: 0; }

/* Trend list */
.trend-list { display: flex; flex-direction: column; gap: 14rpx; }

.tr-row { display: flex; align-items: center; gap: 12rpx; }

.tr-name { width: 128rpx; font-size: 24rpx; color: var(--color-text); flex-shrink: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.tr-bar-bg { flex: 1; height: 28rpx; background: #f3f4f6; border-radius: 14rpx; overflow: hidden; }

.tr-bar { height: 100%; border-radius: 14rpx; min-width: 8rpx; }

.tr-count { font-size: 24rpx; font-weight: 700; color: var(--color-text); width: 60rpx; text-align: right; flex-shrink: 0; }

.tr-change { font-size: 20rpx; font-weight: 700; width: 100rpx; text-align: right; flex-shrink: 0; color: #9ca3af; }

.tr-change.up { color: #ef4444; }

.tr-change.down { color: #22c55e; }

/* AI */
.ai-header { margin-bottom: 20rpx; }

.ai-title { font-size: 28rpx; font-weight: 700; }

.ai-list { display: flex; flex-direction: column; gap: 16rpx; }
