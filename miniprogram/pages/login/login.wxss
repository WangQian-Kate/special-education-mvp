/* 启动页 */
.splash {
  height: 100vh; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: #fff;
}
.splash-logo {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: #eff6ff; display: flex; align-items: center;
  justify-content: center; font-size: 56rpx;
  font-weight: 800; color: #5B9BD5; margin-bottom: 24rpx;
}
.splash-title { font-size: 36rpx; font-weight: 700; color: #1f2937; }
.splash-sub { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
.loading-dot {
  margin-top: 60rpx; width: 48rpx; height: 48rpx;
  border: 4rpx solid #5B9BD5; border-top-color: transparent;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 微信登录 */
.login-card {
  height: 100vh; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  background: #fff; padding: 0 60rpx;
}
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-bottom: 20rpx; background: #f3f4f6; }
.nickname { font-size: 34rpx; font-weight: 700; color: #1f2937; }
.hint { font-size: 26rpx; color: #9ca3af; margin-top: 8rpx; margin-bottom: 48rpx; }
.dev-link { margin-top: 60rpx; font-size: 24rpx; color: #d1d5db; text-align: center; }
.wechat-btn {
  width: 480rpx; height: 96rpx; background: #07C160;
  border-radius: 24rpx; color: #fff; font-size: 32rpx;
  font-weight: 600; display: flex; align-items: center;
  justify-content: center; border: none;
}

/* 注册步骤 */
.onboard-scroll { height: 100vh; background: #EEF0F4; padding: 0 32rpx; }
.ob-header { padding: 60rpx 0 32rpx; }
.ob-title { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.ob-sub { font-size: 26rpx; color: #9ca3af; margin-top: 8rpx; }
.ob-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx;
}
.ob-card.half { flex: 1; }
.ob-row { display: flex; gap: 16rpx; }
.field-label { font-size: 24rpx; color: #9ca3af; margin-bottom: 12rpx; }
.field-input { width: 100%; font-size: 30rpx; color: #1f2937; }
.field-picker { font-size: 30rpx; color: #1f2937; padding: 4rpx 0; }

.checkbox-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.checkbox-item {
  font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 8rpx;
  background: #f3f4f6; color: #6b7280;
}
.checkbox-item.on {
  background: #5B9BD5; color: #fff;
}

.ability-row { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0; }
.ability-row + .ability-row { border-top: 1rpx solid #f3f4f6; }
.ability-label { font-size: 26rpx; color: #374151; }
.ability-opts { display: flex; gap: 12rpx; }
.ability-chip { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 8rpx; background: #f3f4f6; color: #6b7280; }
.ability-chip.on { background: #5B9BD5; color: #fff; }

.onboard-scroll { box-sizing: border-box; width: 100%; overflow-x: hidden; }
.ob-card { box-sizing: border-box; }

.ob-next {
  width: 100%; height: 96rpx; background: #5B9BD5;
  border-radius: 24rpx; color: #fff; font-size: 32rpx;
  font-weight: 600; display: flex; align-items: center;
  justify-content: center; margin: 40rpx 0 80rpx; border: none;
}

/* 开发模式 */
.login-page { min-height: 100vh; padding: 0 40rpx; box-sizing: border-box; }
.logo-area { padding-top: 160rpx; padding-bottom: 60rpx; }
.logo { width: 100rpx; height: 100rpx; border-radius: 50%; background: #eff6ff; font-size: 48rpx; font-weight: 800; color: #5B9BD5; }
.app-name { font-size: 36rpx; font-weight: 700; color: #1f2937; margin-top: 20rpx; }
.app-sub { font-size: 24rpx; color: #9ca3af; margin-top: 8rpx; }
.teacher-list { margin-top: 20rpx; }
.teacher-item { display: flex; align-items: center; padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 16rpx; }
.teacher-item .avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #eff6ff; font-size: 32rpx; font-weight: 700; color: #5B9BD5; margin-right: 20rpx; }
.teacher-item .name { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.teacher-item .desc { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.teacher-item .arrow { margin-left: auto; font-size: 36rpx; color: #d1d5db; }
.flex-column { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.card { background: #fff; border-radius: 16rpx; }
