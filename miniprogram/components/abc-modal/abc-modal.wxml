<view wx:if="{{visible}}" class="abc-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="abc-panel {{records.length ? 'has-records' : 'no-records'}}" catchtap="noop">
    <!-- 头部 -->
    <view class="abc-header">
      <view class="abc-title">{{behavior.behaviorLabel}} · 详细记录</view>
      <view class="abc-close" bindtap="onClose">✕</view>
    </view>

    <!-- 顶部固定：补记 + 时间条 -->
    <view class="abc-top">
      <view class="supp-row" bindtap="onSupplementToggle">+ 补记一次</view>
      <view wx:if="{{supplementOpen}}" class="supp-form">
        <picker mode="time" value="{{supplementTime}}" bindchange="onSupplementTimeChange">
          <view class="supp-time">{{supplementTime}} ▾</view>
        </picker>
        <picker mode="selector" range="{{suppStatusRange}}" value="{{suppStatusIdx}}" bindchange="onSuppStatusChange">
          <view class="supp-status {{suppStatusIdx > 0 ? 'st-'+suppStatusCode : ''}}">{{suppStatusLabel}}</view>
        </picker>
        <view class="supp-confirm {{suppStatusIdx === 0 ? 'supp-disabled' : ''}}" bindtap="onSupplementConfirm">确认补记</view>
      </view>

      <scroll-view scroll-x class="recs-scroll" wx:if="{{records.length}}">
        <view wx:for="{{records}}" wx:key="id"
          class="rec-chip st-{{item.statusCode}} {{currentRecordId === item.id ? 'rec-chip-on' : ''}}"
          bindtap="onRecordTap" data-id="{{item.id}}">
          <text>{{item.timeText}}</text>
          <text wx:if="{{item.detailSaved}}" class="rec-chip-dot">✓</text>
        </view>
      </scroll-view>
      <view wx:if="{{!records.length && !loadingList}}" class="abc-empty">暂无记录，可点击上方补记</view>
    </view>

    <!-- 下方可滚动：详情表单 -->
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="abc-body" wx:if="{{currentRecordId}}">
        <view class="form-item">
          <view class="form-label">持续时间（分钟）</view>
          <picker mode="selector" range="{{durationOptions}}" value="{{durationIndex}}" bindchange="onDurationChange">
            <view class="form-picker">{{durationLabel}} ▾</view>
          </picker>
          <input wx:if="{{durationIndex === durationOptions.length - 1}}" class="form-input" style="margin-top:12rpx" type="number" value="{{form.durationMinutes}}" data-field="durationMinutes" bindinput="onFormInput" placeholder="自定义分钟数" />
        </view>

        <view class="form-item">
          <view class="form-label">A · 行为前因</view>
          <view wx:if="{{abcAntecedentOpts.length}}" class="perf-list">
            <block wx:for="{{abcAntecedentOpts}}" wx:key="code">
              <view wx:if="{{!item.requiresCustomText}}" class="perf-row">
                <view class="perf-check {{antecedentChecks[item.code] ? 'on' : ''}}" data-code="{{item.code}}" bindtap="onAntecedentToggle">{{antecedentChecks[item.code] ? '✓' : ''}}</view>
                <text class="perf-label" data-code="{{item.code}}" bindtap="onAntecedentToggle">{{item.label}}</text>
              </view>
            </block>
            <view class="perf-row">
              <view class="perf-check {{antecedentChecks['_A_OTHER_'] ? 'on' : ''}}" data-code="_A_OTHER_" bindtap="onAntecedentToggle">{{antecedentChecks['_A_OTHER_'] ? '✓' : ''}}</view>
              <text class="perf-label" data-code="_A_OTHER_" bindtap="onAntecedentToggle">其它</text>
            </view>
            <view class="perf-other">
              <input class="perf-input" value="{{antecedentOtherText}}" bindinput="onAntecedentOtherInput" placeholder="请补充具体前因..." maxlength="500" />
            </view>
          </view>
          <textarea wx:else class="form-textarea" value="{{form.antecedentText}}" data-field="antecedentText" bindinput="onFormInput" placeholder="其它：补充前因描述（选填）" maxlength="500" />
        </view>

        <view class="form-item">
          <view class="form-label">B · 行为表现</view>
          <view wx:if="{{perfChecks.length}}" class="perf-list">
            <view wx:for="{{perfChecks}}" wx:key="code" class="perf-row">
              <view class="perf-check {{item.checked ? 'on' : ''}}" data-index="{{index}}" bindtap="onPerfToggle">{{item.checked ? '✓' : ''}}</view>
              <text class="perf-label" data-index="{{index}}" bindtap="onPerfToggle">{{item.label}}</text>
            </view>
            <view wx:if="{{otherText !== undefined}}" class="perf-other">
              <input class="perf-input" value="{{otherText}}" bindinput="onOtherTextInput" placeholder="请填写具体表现..." maxlength="500" />
            </view>
          </view>
          <textarea wx:else class="form-textarea" value="{{form.behaviorDescription}}" data-field="behaviorDescription" bindinput="onFormInput" placeholder="记录具体行为表现..." maxlength="500" />
        </view>

        <view class="form-item">
          <view class="form-label">C · 行为后果</view>
          <view wx:if="{{abcConsequenceOpts.length}}" class="perf-list">
            <block wx:for="{{abcConsequenceOpts}}" wx:key="code">
              <view wx:if="{{!item.requiresCustomText}}" class="perf-row">
                <view class="perf-check {{consequenceChecks[item.code] ? 'on' : ''}}" data-code="{{item.code}}" bindtap="onConsequenceToggle">{{consequenceChecks[item.code] ? '✓' : ''}}</view>
                <text class="perf-label" data-code="{{item.code}}" bindtap="onConsequenceToggle">{{item.label}}</text>
              </view>
            </block>
            <view class="perf-row">
              <view class="perf-check {{consequenceChecks['_C_OTHER_'] ? 'on' : ''}}" data-code="_C_OTHER_" bindtap="onConsequenceToggle">{{consequenceChecks['_C_OTHER_'] ? '✓' : ''}}</view>
              <text class="perf-label" data-code="_C_OTHER_" bindtap="onConsequenceToggle">其它</text>
            </view>
            <view class="perf-other">
              <input class="perf-input" value="{{consequenceOtherText}}" bindinput="onConsequenceOtherInput" placeholder="请补充具体后果..." maxlength="500" />
            </view>
          </view>
          <textarea wx:else class="form-textarea" value="{{form.consequenceText}}" data-field="consequenceText" bindinput="onFormInput" placeholder="其它：补充后果描述（选填）" maxlength="500" />
        </view>

        <!-- ========== 折叠面板：行为功能，辅助方式与辅助结果 ========== -->
        <view class="fold-panel">
          <view class="fold-head" bindtap="toggleFold">
            <text>行为功能，辅助方式与辅助结果</text>
            <text class="fold-arrow">{{foldOpen ? '▲' : '▼'}}</text>
          </view>
          <view class="fold-body" wx:if="{{foldOpen}}">
            <!-- 行为功能 -->
            <view class="form-item">
              <view class="form-label">推测的行为功能</view>
              <picker mode="selector" range="{{functionRange}}" value="{{functionIndex + 1}}" bindchange="onFunctionChange">
                <view class="form-picker">{{functionLabel}} ▾</view>
              </picker>
            </view>

            <!-- 辅助方式勾选 -->
            <view class="form-item">
              <view class="form-label">辅助方式</view>
              <block wx:for="{{assistances}}" wx:key="code">
                <view wx:if="{{item.groupFirst}}" class="assist-group">{{item.group}}</view>
                <view class="assist-row">
                  <view class="assist-check {{item.checked ? 'on' : ''}}" data-index="{{index}}" bindtap="onAssistToggle">{{item.checked ? '✓' : ''}}</view>
                  <text class="assist-label" data-index="{{index}}" bindtap="onAssistToggle">{{item.label}}</text>
                </view>
              </block>
            </view>

            <!-- 辅助结果 -->
            <view class="form-item">
              <view class="form-label">辅助结果</view>
              <textarea class="form-textarea" value="{{form.assistanceResultText}}" data-field="assistanceResultText" bindinput="onFormInput" placeholder="记录辅助结果..." maxlength="500" />
            </view>
          </view>
        </view>

        <!-- 删除按钮 -->
        <view class="rec-del-row">
          <view class="rec-del" bindtap="onDeleteTap" data-id="{{currentRecordId}}" data-saved="{{currentRecordSaved}}">删除本次记录</view>
        </view>

        <button class="abc-save" bindtap="onSave" disabled="{{saving}}">{{saving ? '保存中…' : '保存更新'}}</button>
    </scroll-view>
  </view>
</view>
