.status-bar {
  display: flex; align-items: center;
  padding: 12rpx 16rpx; border-bottom: 2rpx solid var(--color-border);
  background: #f9fafb;
}

.sb-name { width: 200rpx; flex-shrink: 0; font-size: 22rpx; color: var(--color-text-sub); }

.sb-cols { flex: 1; display: flex; }

.sb-col { flex: 1; text-align: center; font-size: 22rpx; font-weight: 700; }
.sb-col:nth-child(1) { color: #5B9BD5; }
.sb-col:nth-child(2) { color: #f59e0b; }
.sb-col:nth-child(3) { color: #22c55e; }
