<wxs module="fmt">
  function count(c, s) { if (!c) return 0; return c[s] || 0; }
  module.exports = { count: count };
</wxs>

<!-- 无子行为：单行 [行为名 | 未完成 | 辅助 | 独立] -->
<block wx:if="{{!behavior.subBehaviors || !behavior.subBehaviors.length}}">
  <view class="br-row {{readonly ? 'br-row-tap' : ''}}" bindtap="{{readonly ? 'onNameTap' : ''}}">
    <view class="br-name-inline" bindtap="{{readonly ? '' : 'onNameTap'}}">{{behavior.name}}</view>
    <view wx:for="{{['incomplete','assisted','independent']}}" wx:for-item="s" wx:key="*this" class="br-col">
      <view class="br-ops">
        <view wx:if="{{!readonly}}" class="br-btn minus" data-sub="" data-status="{{s}}" data-delta="-1" catchtap="onStatusChange">−</view>
        <view class="br-num {{fmt.count(behavior.counts, s) ? '' : 'zero'}}" data-sub="" data-status="{{s}}" data-count="{{fmt.count(behavior.counts, s)}}" catchtap="{{readonly ? '' : 'onStatusTap'}}">{{fmt.count(behavior.counts, s)}}</view>
        <view wx:if="{{!readonly}}" class="br-btn plus s-{{s}}" data-sub="" data-status="{{s}}" data-delta="1" catchtap="onStatusChange">+</view>
      </view>
    </view>
  </view>
</block>

<!-- 有子行为：标题行 + 折叠展开 -->
<block wx:else>
  <view class="br-name has-sub {{readonly ? 'br-row-tap' : ''}}" bindtap="onNameTap">
    <text>{{behavior.name}}</text>
    <text class="br-arrow">{{_expanded ? '▼' : '▶'}}</text>
  </view>
  <view wx:if="{{_expanded}}" wx:for="{{behavior.subBehaviors}}" wx:for-item="sub" wx:key="code" class="br-row sub-row {{readonly ? 'br-row-tap' : ''}}" bindtap="{{readonly ? 'onSubNameTap' : ''}}" data-sub="{{sub.name}}" data-sub-code="{{sub.code}}">
    <view class="br-sub-name" catchtap="{{readonly ? '' : 'onSubNameTap'}}" data-sub="{{sub.name}}" data-sub-code="{{sub.code}}">{{sub.name}}</view>
    <view wx:for="{{['incomplete','assisted','independent']}}" wx:for-item="s" wx:key="*this" class="br-col">
      <view class="br-ops">
        <view wx:if="{{!readonly}}" class="br-btn minus" data-sub="{{sub.name}}" data-status="{{s}}" data-delta="-1" catchtap="onStatusChange">−</view>
        <view class="br-num {{fmt.count(behavior.counts[sub.name], s) ? '' : 'zero'}}" data-sub="{{sub.name}}" data-status="{{s}}" data-count="{{fmt.count(behavior.counts[sub.name], s)}}" catchtap="{{readonly ? '' : 'onStatusTap'}}">{{fmt.count(behavior.counts[sub.name], s)}}</view>
        <view wx:if="{{!readonly}}" class="br-btn plus s-{{s}}" data-sub="{{sub.name}}" data-status="{{s}}" data-delta="1" catchtap="onStatusChange">+</view>
      </view>
    </view>
  </view>
</block>
